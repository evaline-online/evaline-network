function updateToggleDisplay() {
  var s = document.getElementById('main-style');
  var btn = document.getElementById('nocss-toggle');
  var lang = localStorage.getItem('evaline_lang') || 'ru';
  var labels = {
    en: { on: '[ NOCSS: ACTIVE (PURE TERMINAL) — Click for CSS ]', off: '[ CSS: ACTIVE — Click for NOCSS (Terminal) ]' },
    uk: { on: '[ NOCSS: АКТИВНИЙ (ЧИСТИЙ ТЕРМІНАЛ) — Натисніть для CSS ]', off: '[ CSS: АКТИВНИЙ — Натисніть для NOCSS (Термінал) ]' },
    ru: { on: '[ NOCSS: ВКЛЮЧЕН (ЧИСТЫЙ ТЕРМИНАЛ) — Нажмите для CSS ]', off: '[ CSS: ВКЛЮЧЕН — Нажмите для перехода в NOCSS (Терминал) ]' }
  };
  if (btn && s) {
    var l = labels[lang] || labels.ru;
    btn.textContent = s.disabled ? l.on : l.off;
  }
}
updateToggleDisplay();

function toggleCss() {
  var s = document.getElementById('main-style');
  if (!s) return;
  s.disabled = !s.disabled;
  localStorage.setItem('nocss', s.disabled ? '1' : '0');
  updateToggleDisplay();
}

// --- INSTANT MULTI-LANGUAGE ENGINE ---
function setLang(lang) {
  if (!I18N[lang]) return;
  localStorage.setItem('evaline_lang', lang);
  document.documentElement.lang = lang;

  ['en', 'uk', 'ru'].forEach(function(l) {
    var b = document.getElementById('btn-lang-' + l);
    if (b) {
      if (l === lang) {
        b.style.borderColor = '#3fb950';
        b.style.color = '#3fb950';
        b.style.background = 'rgba(46,160,67,0.15)';
      } else {
        b.style.borderColor = '#30363d';
        b.style.color = '#58a6ff';
        b.style.background = '#161b22';
      }
    }
  });

  var dict = I18N[lang];
  for (var k in dict) {
    var el = document.getElementById(k);
    if (el) el.innerHTML = dict[k];
  }

  var phKeys = ['prompt-input', 'search-input'];
  phKeys.forEach(function(id) {
    var inp = document.getElementById(id);
    if (inp && dict['ph_' + id]) inp.placeholder = dict['ph_' + id];
  });

  updateToggleDisplay();
}

