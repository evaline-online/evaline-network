function makeBar(percent, length) {
  length = length || 10;
  var filled = Math.min(length, Math.max(0, Math.round((percent / 100) * length)));
  return '[' + '■'.repeat(filled) + '□'.repeat(length - filled) + ']';
}

function formatUptime(sec) {
  var h = String(Math.floor(sec / 3600)).padStart(2, '0');
  var m = String(Math.floor((sec % 3600) / 60)).padStart(2, '0');
  var s = String(sec % 60).padStart(2, '0');
  return h + ':' + m + ':' + s;
}


var packetCount = 12;
async function pollNet() {
  var start = performance.now();
  try {
    var res = await fetch('/api/health', { cache: 'no-store' });
    var rtt = Math.round(performance.now() - start);
    if (res.ok) {
      var rttEl = document.getElementById('val-rtt');
      var rttMeter = document.getElementById('meter-rtt');
      if (rttEl) rttEl.textContent = rtt + ' ms RTT';
      if (rttMeter) rttMeter.textContent = makeBar(Math.min(100, Math.round(rtt / 2)));
      packetCount++;
      var pkEl = document.getElementById('val-packets');
      if (pkEl) pkEl.textContent = packetCount;
    }
  } catch (e) {}
}
pollNet();
setInterval(pollNet, 4000);

